# BlueGuard Frontend Environment Variables

# API Configuration
VITE_API_URL=http://localhost:8000

# Map Configuration (optional - defaults shown)
VITE_MAP_CENTER_LAT=20.0
VITE_MAP_CENTER_LNG=77.0
VITE_MAP_ZOOM=4

# For Indian Ocean monitoring:
# VITE_MAP_CENTER_LAT=-10.0
# VITE_MAP_CENTER_LNG=70.0
# VITE_MAP_ZOOM=5

# For Mediterranean monitoring:
# VITE_MAP_CENTER_LAT=35.0
# VITE_MAP_CENTER_LNG=18.0
# VITE_MAP_ZOOM=5
