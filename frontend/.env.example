# BlueGuard Frontend Environment Variables

# API Configuration
# Leave empty in development: /api requests are proxied to the backend by Vite
# (target: API_PROXY_TARGET env var, default http://127.0.0.1:8000).
# Set only when the frontend is served separately from the API, e.g. https://api.example.com
VITE_API_URL=

# Map Configuration (optional - defaults shown)
VITE_MAP_CENTER_LAT=20.0
VITE_MAP_CENTER_LNG=77.0
VITE_MAP_ZOOM=4

# For Indian Ocean monitoring:
# VITE_MAP_CENTER_LAT=-10.0
# VITE_MAP_CENTER_LNG=70.0
# VITE_MAP_ZOOM=5

# For Mediterranean monitoring:
# VITE_MAP_CENTER_LAT=35.0
# VITE_MAP_CENTER_LNG=18.0
# VITE_MAP_ZOOM=5
