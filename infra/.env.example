# Supabase
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Database (Supabase PostgreSQL)
# docker-compose uses its bundled PostGIS container unless DATABASE_URL is set.
# Uncomment to use Supabase instead (postgresql:// URL, not the https:// SUPABASE_URL).
# Note: Password special characters must be URL-encoded (@ = %40, ! = %21, * = %2A)
# DATABASE_URL=postgresql://postgres:your-password@db.your-project-id.supabase.co:5432/postgres

# Redis (for Celery tasks - use Upstash or local)
REDIS_URL=redis://localhost:6379/0

# Backend
SECRET_KEY=your-secret-key-change-in-production
JWT_SECRET=your-jwt-secret-change-in-production
JWT_EXPIRES_IN=7d

# Google Gemini API (Required for MIA Chatbot)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Frontend URL
FRONTEND_URL=http://localhost:5173

# ==========================================
# Model Registry Configuration
# ==========================================
# Storage backend for ML models: "local", "supabase", "s3", or "http"
MODEL_STORAGE_BACKEND=local

# Local model paths (used when MODEL_STORAGE_BACKEND=local)
YOLO_MODEL_PATH=models/pollution_yolo.pt
LSTM_MODEL_PATH=models/route_lstm.pt

# Model versions (semantic versioning)
YOLO_MODEL_VERSION=1.0.0
LSTM_MODEL_VERSION=1.0.0

# Remote model paths (used when MODEL_STORAGE_BACKEND != local)
# Format depends on backend:
#   - S3: "bucket-name/path/to/model.pt"
#   - Supabase: "bucket-name/path/to/model.pt"
#   - HTTP: "https://example.com/models/model.pt"
YOLO_MODEL_REMOTE_PATH=
LSTM_MODEL_REMOTE_PATH=

# AWS S3 Configuration (for model storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_MODEL_BUCKET=

# Supabase Storage bucket for models
SUPABASE_MODEL_BUCKET=models

# Local cache directory for downloaded models (optional)
# Defaults to ~/.samudrasense/models
MODEL_CACHE_DIR=

# ==========================================
# Frontend
# ==========================================
# Leave empty to use the Vite dev proxy; set when the API is hosted separately
VITE_API_URL=

# Map Configuration (optional - defaults to global ocean view)
VITE_MAP_CENTER_LAT=20.0
VITE_MAP_CENTER_LNG=77.0
VITE_MAP_ZOOM=4

# External APIs (Optional)

# Copernicus Marine Service API
# Get credentials at: https://data.marine.copernicus.eu/register
COPERNICUS_CLIENT_ID=your-copernicus-client-id
COPERNICUS_CLIENT_SECRET=your-copernicus-client-secret
