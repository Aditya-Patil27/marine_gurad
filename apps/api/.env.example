# SamudraSense Backend Environment Configuration

# Project Settings
PROJECT_NAME=SamudraSense
VERSION=1.0.0

# Server Configuration
PORT=8000
HOST=0.0.0.0
NODE_ENV=development

# Supabase Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here
SUPABASE_SECRET_KEY=your_supabase_secret_key_here
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json

# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql://postgres:your_password@db.your-project-ref.supabase.co:5432/postgres

# Security & Authentication
SECRET_KEY=
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Local offline authentication (A-001). No default credentials exist.
# Set AUTH_COOKIE_SECURE=true when served over HTTPS.
AUTH_SESSION_COOKIE_NAME=samudra_session
AUTH_CSRF_COOKIE_NAME=samudra_csrf
AUTH_SESSION_TTL_MINUTES=480
AUTH_COOKIE_SECURE=false
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_WINDOW_SECONDS=300

# Google Gemini API (Required for MIA Chatbot)
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=
# Gemini model used by MIA (gemini-1.5-* models have been retired)
GEMINI_MODEL=gemini-3.5-flash

# Frontend URL
FRONTEND_URL=http://localhost:5173

# Model Paths
YOLO_MODEL_PATH=models/pollution_yolo.pt
LSTM_MODEL_PATH=models/route_lstm.pt

# Thresholds
POLLUTION_CONFIDENCE_THRESHOLD=0.5

# CORS Origins (JSON array format - required by Pydantic)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Optional: Redis (only if using Celery background tasks)
# REDIS_URL=redis://localhost:6379/0

# Local report delivery sink (no public email is sent).
DELIVERY_LOCAL_SINK_DIR=data/delivery_sink
OFFLINE_MODE=false

# Optional: Google OAuth (only if implementing user authentication)
# GOOGLE_CLIENT_ID=your_google_client_id
# GOOGLE_CLIENT_SECRET=your_google_client_secret
# GOOGLE_CALLBACK_URL=http://localhost:8000/api/auth/google/callback

# Marine data providers: keep credentials in the local .env file only.
AISSTREAM_API_KEY=
GFW_API_TOKEN=
COPERNICUS_MARINE_USERNAME=
COPERNICUS_MARINE_PASSWORD=
# Leave false unless the account holder has confirmed AISStream retention rights.
AISSTREAM_PERSIST_ENABLED=false
