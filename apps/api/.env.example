# SamudraSense Backend Environment Configuration

# Project Settings
PROJECT_NAME=SamudraSense
VERSION=1.0.0

# Server Configuration
PORT=8000
HOST=0.0.0.0
NODE_ENV=development

# Supabase Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql://postgres:your_password@db.your-project-ref.supabase.co:5432/postgres

# Security & Authentication
SECRET_KEY=generate_a_long_random_string
JWT_SECRET=generate_a_long_random_string
JWT_EXPIRES_IN=7d

# Google Gemini API (Required for MIA Chatbot)
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Gemini model used by MIA (gemini-1.5-* models have been retired)
GEMINI_MODEL=gemini-2.5-flash

# Frontend URL
FRONTEND_URL=http://localhost:5173

# Model Paths
YOLO_MODEL_PATH=models/pollution_yolo.pt
LSTM_MODEL_PATH=models/route_lstm.pt

# Thresholds
POLLUTION_CONFIDENCE_THRESHOLD=0.5
IUU_RISK_THRESHOLD=0.7

# CORS Origins (JSON array format - required by Pydantic)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Optional: Redis (only if using Celery background tasks)
# REDIS_URL=redis://localhost:6379/0

# Optional: Google OAuth (only if implementing user authentication)
# GOOGLE_CLIENT_ID=your_google_client_id
# GOOGLE_CLIENT_SECRET=your_google_client_secret
# GOOGLE_CALLBACK_URL=http://localhost:8000/api/auth/google/callback
